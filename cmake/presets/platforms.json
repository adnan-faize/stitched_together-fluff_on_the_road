{
  "version": 6,
  "configurePresets": [
    {
      "name": "platform-windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows"
      }
    },
    {
      "name": "platform-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux"
      }
    },
    {
      "name": "platform-macos",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "MacOS"
      }
    },
    {
      "name": "platform-switch",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/devkitpro/cmake/Switch.cmake"
      }
    },
    {
      "name": "platform-ps4",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ps4.toolchain.cmake"
      }
    }
  ]
}
